// Case for the halo2-controller: DOIT ESP32 DevKit V1 (30 pads, ESP-WROOM-32, CP2102) without pin headers, wires
// soldered directly, BM5602-60-1 glued flat on the underside towards the USB end, and a 5 V USB-C PD board as a
// second power input (to VIN and GND). Units mm, Z up. Modules build every part in its INSTALLED position; the part branches at the end put
// each print part into PRINT orientation (largest flat face on the bed at z = 0). The tools set `part`.
//
// Layout: the DevKit is screwed through its four corner holes onto bosses with M2 self-tapping screws, its micro-USB in a cut-out of the thin front wall (-x); below it there is room for the glued module and the
// wire loops. The PD board hangs upside down under the lid, screwed with two M2 self-tapping screws through its two
// middle holes into a boss of the lid; its USB-C sits in a second cut-out right above. Both receptacles reach into
// their cut-outs, so the DevKit and the lid go in a little behind their place and slide forward. Four M3 x 8
// (ISO 7380) sink into bridged counterbores in the lid and reach Ruthex RX-M3x5.7 inserts in bosses beside the PCB,
// which makes the box wider than the DevKit. The bottom carries an inverted QR code to the GitHub repo, printed in
// two colours with the AMS: the modules grey in the first three layers, the black floor around them the quiet zone.

use <lib/opp_parts.scad>;
include <qr_repo.scad>;   // qr_url, qr_matrix: generated by make_qr.py

part = "assembly";   // print part, "box_base" / "box_qr", "assembly", "exploded", "metrics", "none"
$fa = 2;
$fs = 0.4;
eps = 0.01;

/* [DevKit: DOIT DevKit V1 from the flatbed scan 2026-10-27; stack height measured on the first board, split estimated] */
kit_l = 51.65;       // PCB length (x), USB end at -x
kit_w = 28.1;        // PCB width (y): upper bound, the scan shadow blurs the long edges
kit_t = 1.6;         // PCB thickness
stack_h = 12.0;      // measured 2026-10-27 on the first board: module and wires below, PCB, tallest part on top
top_lo = 3.0;        // least height on top: the WROOM alone is 3.1
top_h = 3.8;         // most height on top (WROOM shield, receptacle, buttons)
under_h = stack_h - kit_t - top_lo;   // room below the PCB for any split between top_lo and top_h
kit_hole_d = 3.0;    // corner holes (scan: plated ring with a 2.0-2.2 light core)
kit_hole_e = 2.46;   // hole centres from each PCB end: 46.73 apart (scan)
kit_hole_s = (kit_w - 23.5) / 2;  // 23.5 apart across, centred on the board (scan)
wroom_l = 25.5;      // ESP-WROOM-32 incl. antenna, at the +x end
wroom_w = 18;
wroom_end = 0.3;     // module edge to the PCB end (photo)
wroom_ant = 6.0;     // antenna part at the +x end: module PCB only, no shield (estimate)
usb_w = 7.6;         // micro-USB receptacle on top at the -x end
usb_h = 2.8;
usb_over = 0.4;      // receptacle front beyond the PCB end (scan 0.3)
btn = [5.0, 3.0, 2.5];   // EN and BOOT beside the receptacle: length (x), width (y), height (photo estimate)
btn_y = 7.95;        // their centres from the centre line, about 3.8 inside the hole axes (photo)
bm_l = 17.7;         // BM5602 on the underside (photo estimate)
bm_w = 19.5;
bm_h = 3.2;          // module PCB, parts and glue below the DevKit

/* [USB-C PD board, 5 V: outline from the flatbed scan 2026-10-27, heights estimated] */
pd_l = 30.6;
pd_w = 19.7;
pd_t = 1.6;
pdc_w = 8.94;        // USB-C receptacle on the component side at the -x end
pdc_l = 7.35;
pdc_h = 3.2;
pdc_over = 0.9;      // receptacle front beyond the PCB edge (scan)
pd_parts = 1.5;      // other parts on the component side
pd_stub = 1.0;       // receptacle legs and solder joints on the table side
pd_hole_y = 2.5;     // the two plated holes in the middle of the far end, +-2.5 from the centre line (scan)
pd_hole_e = 2.2;     // hole centres from the far end (scan, 1.6-2.5): the screws locate the board, measure
pd_hole_d = 2.1;     // scan: about 2.0
pd_pads = 5.0;       // wire pads in the corners of the far end, up to this far from it (scan)

/* [PD board screws: M2 self-tapping pan heads from Fabian's VooGenzek set, up through the board into the lid] */
pd_screw = [2.0, 6, 4.0, 1.8];   // M2 x 6: shank, under-head length, head diameter, head height envelope
pd_pilot_d = 1.6;    // starting pilot (0.8 D); verify on printed PETG
pd_pilot_mouth = [2.3, 0.4];     // relieved mouth: diameter, depth
pd_skin = 1.5;       // pilot end to the visible lid top
pd_boss_r = 2.3;     // around each hole; the two merge into one block
pd_rest = [8.0, 1.2];            // rests under the table side long edges at the receptacle end: length, width

/* [Plugs (overmould envelopes) and cut-outs] */
plug_w = 11.5;       // micro-USB
plug_h = 8.0;
plug_gap = 1.5;      // overmould front to the receptacle front when plugged in
cplug_w = 12.0;      // USB-C
cplug_h = 7.0;
cplug_gap = 0.3;
port_cl = 0.25;      // cut-out clearance around each receptacle
port_bar = 1.2;      // web between the two cut-outs

/* [DevKit screws: M2 self-tapping like the PD board; the head (4.0) clears EN and BOOT, the 3.0 holes leave play] */
kit_screw = pd_screw;
kit_pilot_d = pd_pilot_d;
kit_pilot_mouth = pd_pilot_mouth;
kit_boss_d = 4.4;

/* [Case] */
wall = 2.0;          // five 0.4 mm lines
wall_front = 1.0;    // thin front wall: the receptacles end close to the outer face so the plugs seat fully
floor_t = 1.6;
corner_r = 2.5;
kit_cl = 0.4;        // clearance beside the PCB
kit_front = 0.1;     // PCB end to the front wall
head_cl = 0.3;       // above the tallest part on top (top_h is already the upper bound)
insert = "M3";       // Ruthex RX-M3x5.7: hole 4.0, datasheet wall 1.6, length 5.7
insert_hole = 4.0;
insert_wall = 1.6;
insert_extra = 1.5;  // pocket below the insert for the screw tip
boss_d = insert_hole + 2 * insert_wall;
boss_pcb_gap = 0.4;  // boss to the PCB clearance zone
boss_edge = 4.4;     // screw axis to the outer faces: the head counterbore keeps 1.2 mm to the edge

/* [Lid] */
lid_t = 3.2;         // carries the screw counterbores
cb_d = 1.8;          // counterbore depth: the ISO 7380 head (1.65) ends 0.15 below the top
cb_dia = 6.4;
screw_cl = 3.4;
m3_head = [5.7, 1.65];
lid_lip_h = 3;       // lips along the long sides between the bosses
lid_lip_t = 1.2;
lid_cl = 0.2;        // clearance per side between lip and box wall
screw_l = 8;         // ISO 7380 M3 x 8 (in stock)
pd_front = 0.05;     // PD board edge to the front wall

/* [QR code on the bottom, inverted: grey modules in the first three layers of the black floor] */
// Inverted codes need a scanner that tries both polarities: Fabian's iPhone camera reads it (render, 2026-10-28)
inlay_t = 0.6;
qr_module = 1.0;     // module pitch: single modules and gaps stay above the 0.8 mm inlay minimum
qr_quiet = 4;        // quiet zone in modules the floor must leave around the code (QR standard)
qr_grow = 0.02;      // modules overlap their diagonal neighbours: no zero-width necks in either colour

assert(wall >= 3 * 0.4, "Walls need at least three perimeters");

// ---------- derived layout ----------
kit_x0 = -kit_l / 2;
kit_x1 = kit_l / 2;
kit_y0 = -kit_w / 2;
kit_slide = usb_over - kit_front + 0.2;             // DevKit goes in this far behind its place, then forward
lid_slide = pdc_over - pd_front + 0.25;             // same for the lid with the PD board
x_in0 = kit_x0 - kit_front;
x_in1 = kit_x1 + kit_slide + 0.2;
boss_y = kit_w / 2 + kit_cl + boss_pcb_gap + boss_d / 2;
y_o = boss_y + boss_edge;
y_in = y_o - wall;
x_o0 = x_in0 - wall_front;
x_o1 = x_in1 + wall;
box_l = x_o1 - x_o0;
box_w = 2 * y_o;
xc = (x_o0 + x_o1) / 2;
boss_xy = [for (bx = [x_o0 + boss_edge, x_o1 - boss_edge], sy = [-1, 1]) [bx, sy * boss_y]];
kit_holes = [for (sx = [-1, 1], sy = [-1, 1]) [sx * (kit_l / 2 - kit_hole_e), sy * (kit_w / 2 - kit_hole_s)]];
kit_pilot_depth = kit_screw[1] - kit_t + 1;
bm_end = kit_hole_e + kit_boss_d / 2 + 0.6;          // module behind the bosses at the USB end
z_pcb = floor_t + under_h;                          // PCB underside
z_usb = z_pcb + kit_t + usb_h / 2;                  // micro-USB axis
// PD board upside down: its receptacle above the micro-USB one with room for the web, its parts above the DevKit top
pdc_gap = port_bar + 2 * port_cl;
z_pdb = max(z_pcb + kit_t + usb_h + pdc_gap + pdc_h, z_pcb + kit_t + top_h + 0.3 + pd_parts);   // component side
z_pdt = z_pdb + pd_t;                               // table side, facing the lid
z_pdc = z_pdb - pdc_h;                              // underside of the USB-C receptacle
z_c = z_pdc + pdc_h / 2;                            // USB-C axis
pd_pilot_depth = pd_screw[1] - pd_t + 0.3;          // from the table side up into the lid
pd_standoff = max(pd_stub + 0.2, pd_pilot_depth + pd_skin - lid_t);   // table side to the lid: the boss height
box_h = max(z_pcb + kit_t + top_h + head_cl, z_pdt + pd_standoff);
usb_x0 = kit_x0 - usb_over;                         // micro-USB front
pd_x0 = x_in0 + pd_front;
pd_x1 = pd_x0 + pd_l;
pdc_x0 = pd_x0 - pdc_over;                          // USB-C front
pd_holes = [for (sy = [-1, 1]) [pd_x1 - pd_hole_e, sy * pd_hole_y]];
pocket_depth = 5.7 + insert_extra;
screw_engage = screw_l - (lid_t - cb_d);
lip_x0 = boss_xy[0][0] + boss_d / 2 + 0.4;
lip_x1 = boss_xy[2][0] - boss_d / 2 - 0.4 - lid_slide - 0.1;

assert(screw_engage <= pocket_depth - 0.2, "Screw longer than the insert pocket");
assert(screw_engage >= 5.7, "Screw does not reach through the insert");
assert(lid_t - cb_d - 0.4 >= 0.8, "Too little lid under the counterbore bridges");
assert(boss_edge - cb_dia / 2 >= 1.2, "Counterbore too close to the lid edge");
assert(boss_edge - insert_hole / 2 >= insert_wall, "Insert too close to the outer face");
assert(kit_pilot_depth <= z_pcb - floor_t + floor_t - 0.8, "DevKit pilot runs through the floor");
assert(kit_boss_d >= kit_pilot_d + 2 * 1.2, "DevKit boss wall below 1.2 mm");
assert(box_h - floor_t >= 5.7 + 1.6, "Boss shorter than insert + floor");
assert(usb_x0 - plug_gap <= x_o0, "Micro-USB plug hits the front wall before it seats");
assert(pdc_x0 - cplug_gap <= x_o0, "USB-C plug hits the front wall before it seats");
assert(pd_standoff + lid_t - pd_pilot_depth >= pd_skin - eps, "PD pilot too close to the lid top");
assert(pd_hole_d > pd_screw[0], "M2 shank does not pass the PD board holes");
assert(box_w - corner_r - len(qr_matrix) * qr_module >= 2 * qr_quiet * qr_module, "Floor too narrow for the QR quiet zone");
assert(z_pdb - pd_screw[3] >= z_pcb + kit_t + top_h + 0.3, "PD screw heads reach down to the DevKit parts");

// ---------- helpers ----------
module rounded_rect(w, d, r) offset(r = r) offset(delta = -r) square([w, d], center = true);
module outer2d() translate([xc, 0]) rounded_rect(box_l, box_w, corner_r);
module inner2d(grow = 0) translate([(x_in0 + x_in1) / 2, 0]) rounded_rect(x_in1 - x_in0 + 2 * grow, 2 * (y_in + grow), 0.5);
// cut-out through the front wall around a receptacle: h tall (z), w wide (y), centred on y = 0 and z
module port(z, w, h, r) translate([x_o0 - eps, 0, z]) rotate([0, 90, 0]) linear_extrude(wall_front + 2 * eps)
    rounded_rect(h, w, r);

// ---------- bought parts (envelopes) in installed position ----------
module devkit() {
    wx = kit_x1 - wroom_end - wroom_l;
    difference() {
        translate([kit_x0, kit_y0, z_pcb]) cube([kit_l, kit_w, kit_t]);
        for (h = kit_holes) translate([h[0], h[1], z_pcb - 1]) cylinder(d = kit_hole_d, h = kit_t + 2);
    }
    translate([wx, -wroom_w / 2, z_pcb + kit_t]) cube([wroom_l - wroom_ant, wroom_w, 3.2]);
    translate([wx, -wroom_w / 2, z_pcb + kit_t]) cube([wroom_l, wroom_w, 1.0]);
    translate([usb_x0, -usb_w / 2, z_pcb + kit_t]) cube([5.5, usb_w, usb_h]);
    for (sy = [-1, 1]) translate([kit_x0 + 0.3, sy * btn_y - btn[1] / 2, z_pcb + kit_t]) cube([btn[0], btn[1], btn[2]]);
}
module bm5602() translate([kit_x0 + bm_end, -bm_w / 2, z_pcb - bm_h]) cube([bm_l, bm_w, bm_h]);
// PD board upside down: receptacle and parts face down, legs and solder joints face the lid
module pdboard() {
    difference() {
        translate([pd_x0, -pd_w / 2, z_pdb]) cube([pd_l, pd_w, pd_t]);
        for (h = pd_holes) translate([h[0], h[1], z_pdb - 1]) cylinder(d = pd_hole_d, h = pd_t + 2, $fn = 24);
    }
    // the receptacle shell is a stadium: half circles at both ends
    hull() for (sy = [-1, 1]) translate([pdc_x0, sy * (pdc_w - pdc_h) / 2, z_c]) rotate([0, 90, 0]) cylinder(d = pdc_h, h = pdc_l);
    // other parts, but none under the screw heads
    difference() {
        translate([pdc_x0 + pdc_l, -pd_w / 2 + 0.5, z_pdb - pd_parts]) cube([pd_x1 - pdc_x0 - pdc_l - 0.5, pd_w - 1, pd_parts + eps]);
        for (h = pd_holes) translate([h[0], h[1], z_pdb - pd_parts - 1]) cylinder(d = pd_screw[2] + 0.6, h = pd_parts + 2);
    }
    // table side: receptacle legs at the front, wire joints in the corners of the far end
    translate([pd_x0 + 0.5, -pd_w / 2 + pd_rest[1] + 0.3, z_pdt - eps]) cube([7.0, pd_w - 2 * pd_rest[1] - 0.6, pd_stub + eps]);
    for (sy = [-1, 1]) translate([pd_x1 - pd_pads, sy > 0 ? pd_hole_y + pd_boss_r + 0.4 : -pd_w / 2, z_pdt - eps])
        cube([pd_pads, pd_w / 2 - pd_hole_y - pd_boss_r - 0.4, pd_stub + eps]);
}
// Overmoulds of plugged-in cables, 20 mm of each; only one is plugged in at a time
module usb_plug() translate([usb_x0 - plug_gap - 20, -plug_w / 2, z_usb - plug_h / 2]) cube([20, plug_w, plug_h]);
module usbc_plug() translate([pdc_x0 - cplug_gap - 20, -cplug_w / 2, z_c - cplug_h / 2]) cube([20, cplug_w, cplug_h]);
module screws() for (p = boss_xy) translate([p[0], p[1], box_h + lid_t - cb_d]) {
    cylinder(d = m3_head[0], h = m3_head[1]);
    translate([0, 0, -screw_l]) cylinder(d = 2.9, h = screw_l + eps);
}
module pd_screws() for (h = pd_holes) translate([h[0], h[1], z_pdb]) {
    translate([0, 0, -pd_screw[3]]) cylinder(d = pd_screw[2], h = pd_screw[3]);
    cylinder(d = pd_screw[0], h = pd_screw[1] + eps);
}
module kit_screws() for (h = kit_holes) translate([h[0], h[1], z_pcb + kit_t]) {
    cylinder(d = kit_screw[2], h = kit_screw[3]);
    translate([0, 0, -kit_screw[1]]) cylinder(d = kit_screw[0], h = kit_screw[1] + eps);
}

// ---------- printed parts in installed position ----------
module box() difference() {
    union() {
        difference() {
            linear_extrude(box_h) outer2d();
            translate([0, 0, floor_t]) linear_extrude(box_h) inner2d();
        }
        // DevKit bosses under the four corner holes
        for (h = kit_holes) translate([h[0], h[1], floor_t - eps]) cylinder(d = kit_boss_d, h = under_h + eps);
        for (p = boss_xy) translate([p[0], p[1], floor_t - eps]) cylinder(d = boss_d, h = box_h - floor_t + eps);
    }
    for (p = boss_xy) translate([p[0], p[1], box_h]) opp_insert_pocket(insert, insert_extra);
    for (h = kit_holes) translate([h[0], h[1], z_pcb]) {
        translate([0, 0, -kit_pilot_depth]) cylinder(d = kit_pilot_d, h = kit_pilot_depth + eps);
        translate([0, 0, -kit_pilot_mouth[1]]) cylinder(d = kit_pilot_mouth[0], h = kit_pilot_mouth[1] + eps);
    }
    port(z_usb, usb_w + 2 * port_cl, usb_h + 2 * port_cl, 0.6);
    port(z_c, pdc_w + 2 * port_cl, pdc_h + 2 * port_cl, (pdc_h + 2 * port_cl) / 2 - 0.01);
}

// PD board seat under the lid (lid frame, underside at z = 0): one boss for both screws at the far end, two rests
// under the long edges at the receptacle end
module pd_mount() translate([0, 0, -pd_standoff]) {
    hull() for (h = pd_holes) translate([h[0], h[1], 0]) cylinder(r = pd_boss_r, h = pd_standoff + eps);
    for (sy = [-1, 1]) translate([pd_x0, sy > 0 ? pd_w / 2 - pd_rest[1] : -pd_w / 2, 0]) cube([pd_rest[0], pd_rest[1], pd_standoff + eps]);
}
module pd_pilots() for (h = pd_holes) translate([h[0], h[1], -pd_standoff]) {
    translate([0, 0, -eps]) cylinder(d = pd_pilot_d, h = pd_pilot_depth + eps, $fn = 24);
    translate([0, 0, -eps]) cylinder(d = pd_pilot_mouth[0], h = pd_pilot_mouth[1] + eps, $fn = 24);
}

// Counterbore that prints face down without supports, local frame with the face at z = 0 and +z into the part (as in
// nas-case): radius R to depth d, then two bridge layers (a slot, then a square), then the hole r through t.
module bridged_counterbore(r, R, d, t, l = 0.2, fn = 48) {
    translate([0, 0, -eps]) cylinder(r = R, h = d + eps, $fn = fn);
    translate([0, 0, d - 0.1]) linear_extrude(l + 0.1) intersection() { circle(r = R - 0.1, $fn = fn); square([2 * R, 2 * r + 1], center = true); }
    translate([0, 0, d + l]) linear_extrude(l) intersection() { circle(r = R - 0.2, $fn = fn); square(2 * r + 1, center = true); }
    translate([0, 0, -eps]) cylinder(r = r, h = t + 2 * eps, $fn = fn);
}

module lid() {       // underside of the plate at z = 0, resting on the box rim
    difference() {
        union() {
            linear_extrude(lid_t) outer2d();
            // lips along the long sides between the bosses; none at the ends, where the lid slides
            intersection() {
                translate([0, 0, -lid_lip_h]) linear_extrude(lid_lip_h + eps) difference() {
                    inner2d(-lid_cl);
                    inner2d(-lid_cl - lid_lip_t);
                }
                translate([lip_x0, -box_w, -lid_lip_h - 1]) cube([lip_x1 - lip_x0, 2 * box_w, lid_lip_h + 2]);
            }
            pd_mount();
        }
        pd_pilots();
        // M3 heads sunk into the top; the lid prints top down, so two bridge layers carry each counterbore floor
        for (p = boss_xy) translate([p[0], p[1], lid_t]) rotate([180, 0, 0])
            bridged_counterbore(screw_cl / 2, cb_dia / 2, cb_d, lid_t + 1);
    }
}

// Modules of the QR code (the dark ones of a normal code) in the installed top view. Columns run right to left
// because it is read from below (the box turned over), so the code is not mirrored there.
module qr_modules_2d() {
    n = len(qr_matrix);
    translate([xc, 0]) for (r = [0 : n - 1], c = [0 : n - 1]) if (qr_matrix[r][c] == 1)
        translate([(n / 2 - 1 - c) * qr_module - qr_grow, (n / 2 - 1 - r) * qr_module - qr_grow])
            square(qr_module + 2 * qr_grow);
}
module qr_zone() translate([0, 0, -eps]) linear_extrude(inlay_t + eps) qr_modules_2d();
module box_base() difference() { box(); qr_zone(); }
module box_qr() intersection() { box(); qr_zone(); }

// Lid top face down on the bed: a real 180 degree turn about x (never a mirror).
module lid_print_pose() translate([0, 0, lid_t]) rotate([180, 0, 0]) children();

module assembly(explode = 0) {
    color("#3b3f45") box_base();
    color("#9ea2a5") box_qr();
    color("#6b7078") translate([0, 0, box_h + 2 * explode]) lid();
    color("#7a3fbf") translate([0, 0, 1.5 * explode]) pdboard();
    color("#1f5fbf") translate([0, 0, explode]) devkit();
    color("#2a7de1") translate([0, 0, explode]) bm5602();
    color("#9aa3ab") translate([0, 0, 3 * explode]) screws();
    color("#c8ccd0") translate([0, 0, 2 * explode]) kit_screws();
    color("#c8ccd0") translate([0, 0, 1.2 * explode]) pd_screws();
}

// ---------- branches: the tools check that opp.toml [parts] matches them ----------
if      (part == "assembly") assembly();
else if (part == "exploded") assembly(20);
else if (part == "metrics") echo("PROJECT_METRICS", [
    ["wall", wall], ["wall_front", wall_front], ["lid_clearance", lid_cl], ["kit_holes", kit_holes],
    ["kit_hole_cl", (kit_hole_d - kit_screw[0]) / 2], ["bm_end", bm_end],
    ["pd_holes", pd_holes], ["pd_hole_cl", (pd_hole_d - pd_screw[0]) / 2], ["pd_standoff", pd_standoff],
    ["pd_pilot_depth", pd_pilot_depth], ["pd_skin", pd_standoff + lid_t - pd_pilot_depth],
    ["kit_front", kit_front], ["pd_front", pd_front], ["kit_slide", kit_slide], ["lid_slide", lid_slide],
    ["outer_mm", [box_l, box_w, box_h + lid_t]], ["inner_mm", [x_in1 - x_in0, 2 * y_in, box_h - floor_t]],
    ["under_h", under_h], ["z_pcb", z_pcb], ["z_usb", z_usb], ["z_usbc", z_c], ["box_h", box_h], ["boss_xy", boss_xy],
    ["pocket_depth", pocket_depth], ["screw_engage", screw_engage], ["cb_d", cb_d], ["lid_t", lid_t],
    ["usb_recess", usb_x0 - x_o0], ["usbc_recess", pdc_x0 - x_o0], ["port_bar", port_bar]]);
else if (part == "none") {}
else if (part == "box") box();
else if (part == "box_base") box_base();
else if (part == "box_qr") box_qr();
else if (part == "lid") lid_print_pose() lid();
